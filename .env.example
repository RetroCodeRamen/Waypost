# Waypost Station — example environment (copy to .env; never commit .env)

# --- Core ---
WAYPOST_ENV=development
WAYPOST_DATA_DIR=./data
WAYPOST_SQLITE_PATH=./data/waypost.db
WAYPOST_LOG_LEVEL=INFO

# --- Network / DNS ---
WAYPOST_DOMAIN=waypost.home.arpa
WAYPOST_SSID=WAYPOST
WAYPOST_WIFI_PASSWORD=changeme-wpa3
WAYPOST_HOTSPOT_INTERFACE=wlan0
WAYPOST_HOTSPOT_CHANNEL=6
WAYPOST_HOTSPOT_IP=10.42.0.1
WAYPOST_DHCP_RANGE_START=10.42.0.50
WAYPOST_DHCP_RANGE_END=10.42.0.200

# --- API ---
WAYPOST_API_HOST=0.0.0.0
WAYPOST_API_PORT=8000
WAYPOST_SECRET_KEY=replace-with-long-random-string

# --- Waylink / radio ---
WAYPOST_LORA_DEVICE=/dev/waypost-lora
WAYPOST_TRANSPORT=mock
# WAYPOST_TRANSPORT=reticulum
WAYPOST_RADIO_REGION=US
WAYPOST_RADIO_FREQUENCY_HZ=915000000
WAYPOST_RADIO_TX_POWER_DBM=14

# --- Registration ---
# OPEN | INVITE_ONLY | ADMIN_APPROVAL
WAYPOST_REGISTRATION_MODE=OPEN

# --- Integrated services (Phase 4+) ---
# STALWART_URL=http://stalwart:8080
# BOOKSTACK_URL=http://bookstack:80
# MEMOS_URL=http://memos:5230
# KIWIX_URL=http://kiwix:8080
