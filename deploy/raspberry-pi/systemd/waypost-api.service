[Unit]
Description=Waypost Station API
After=network.target

[Service]
Type=simple
User=waypost
WorkingDirectory=/opt/waypost
EnvironmentFile=-/etc/waypost/waypost.env
Environment=PYTHONPATH=/opt/waypost
ExecStart=/opt/waypost/.venv/bin/uvicorn server.api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
