#!/usr/bin/env bash
# Set a Station account's password on the Pi:  sudo waypost-set-password USERNAME
# (asks for it twice; see server/admin/set_password.py)
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "run with sudo: sudo $0 ${1:-USERNAME}" >&2; exit 1; }
[[ $# -eq 1 ]] || { echo "usage: sudo $0 USERNAME" >&2; exit 2; }
# Station's settings (database, data dir) for the tool, as the service has them.
set -a
. /etc/waypost/waypost.env
set +a
export PYTHONPATH=/opt/waypost
cd /opt/waypost
# As the service user (it owns the database); runuser keeps the environment.
exec runuser -u waypost -- /opt/waypost/.venv/bin/python -m server.admin.set_password "$1"
