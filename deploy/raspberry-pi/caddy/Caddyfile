# Waypost Station — Caddy (installed to /etc/caddy/Caddyfile by install.sh)
#
# HTTPS from Caddy's offline local CA. Plain HTTP only serves what a device
# needs before it trusts that CA: the CA cert and the trust page.
#
# The Pi has no battery-backed clock, so it can boot hours or days behind real
# time. Leaf certs are 30 days (default 12h) so clients still accept certs
# issued by a Station whose clock lags — see docs/network-time.md.

{
	skip_install_trust
	auto_https disable_redirects
	pki {
		ca local {
			name "Waypost Station"
			root_cn "Waypost Station Local CA"
			intermediate_lifetime 365d
		}
	}
}

(waypost_api) {
	encode gzip
	reverse_proxy 127.0.0.1:8000
}

https://waypost.home.arpa, https://waypost, https://10.42.0.1 {
	tls {
		issuer internal {
			lifetime 30d
		}
	}
	import waypost_api
}

http:// {
	handle /waypost-ca.crt {
		root * /etc/waypost/public
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle /waypost-ca.sha256 {
		root * /etc/waypost/public
		header Content-Type text/plain
		file_server
	}
	handle /trust.html {
		import waypost_api
	}
	handle /static/* {
		import waypost_api
	}
	handle {
		redir * /trust.html?next={http.request.uri.path} 302
	}
}
